# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Brevo (Email Marketing)
BREVO_API_KEY=xkeysib-...

# PostHog Analytics
# Clé publique d'ingestion (côté client, sans risque à exposer)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Personal API key pour LIRE les données via l'API (scripts fetch_posthog*, admin-dashboard).
# Usage LOCAL / serveur uniquement — ne jamais exposer côté client ni committer en dur.
# Créer une clé SANS expiration : PostHog > Settings > Personal API keys > Create.
POSTHOG_PERSONAL_API_KEY=phx_...
POSTHOG_PROJECT_ID=112119

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
